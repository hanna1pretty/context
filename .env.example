# Copy to .env locally. PLACEHOLDERS ONLY -- never put real secrets here or in git.
APP_ENV=development
APP_NAME=context-intelligence-bot
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
# Display name used inside bot messages (/start welcome, help). This is
# NOT the Telegram BotFather display name (currently Kaguya in live
# screenshots) -- change that name in BotFather, not here.
BOT_DISPLAY_NAME=OktaScrape
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# PRIMARY way to set the Context.dev key: /admin > Set Context API Key
# (private chat only, stored Fernet-encrypted in admin_settings).
# This env var is now OPTIONAL -- it is only the fallback at call time
# if no admin-panel key is stored. Leave empty if you use /admin.
CONTEXT_DEV_API_KEY=
# REQUIRED before any admin-panel key can be saved: the Fernet key that
# encrypts admin_settings. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this value makes previously stored keys undecryptable -- set
# the API key again via /admin after rotation. Never commit a real value.
SETTINGS_ENCRYPTION_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev/v1
CONTEXT_DEV_TIMEOUT_SECONDS=60
CONTEXT_DEV_MAX_CONCURRENCY=10
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/context_bot
REDIS_URL=redis://redis:6379/0
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhooks/telegram
CONTEXT_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
DEFAULT_LANGUAGE=id
DEFAULT_TIMEZONE=Asia/Jakarta
MAX_TELEGRAM_MESSAGE_LENGTH=3900
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_GLOBAL_QUEUE_SIZE=10000
FREE_DAILY_LIMIT=10
PRO_DAILY_LIMIT=100
BUSINESS_DAILY_LIMIT=1000
